# Supabase — Dashboard → Project Settings → API Keys, or the Connect dialog.
# Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same publishable key. Preferred when set; clients fall back to the anon key above.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy service_role JWT. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Server SDK names (same values as the public URL, publishable key, and secret key above).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Anthropic — https://console.anthropic.com/settings/keys
# Server only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Office mailbox for signup and approval mail. Google Workspace app password.
# Server only. Never prefix with NEXT_PUBLIC_.
SMTP_USER=admin@fibreconstruction.com
SMTP_APP_PASSWORD=
SMTP_FROM=Fibre Construction <admin@fibreconstruction.com>
# Shared with the Supabase send-mail function. Server only.
MAIL_INVOKE_SECRET=
# Unlocks saved passwords so forgot-password can email the existing login. 64 hex characters. Server only.
PASSWORD_BOX_KEY=

# Public URL of this app.
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
# Permanent Excel links use ${NEXT_PUBLIC_APP_URL}/r/{expense_id} and /i/{invoice_id}.
NEXT_PUBLIC_APP_URL=http://localhost:3000
